# ==============================================================================
# 1. SISTEMA OPERACIONAL E IDEs (Global)
# ==============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# Arquivos de ambiente locais globais
.env
.env.local
.env.*.local
docker-compose.override.yml

# ==============================================================================
# 2. FRONTEND (React / Node.js)
# ==============================================================================
# Dependências
node_modules/
/.pnp
.pnp.js

# Logs de gerenciadores de pacote
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Builds e Distribuição
/dist/
/build/
.next/
out/

# Caches e testes
.eslintcache
.stylelintcache
coverage/
.jest/

# ==============================================================================
# 3. BACKEND (Laravel / PHP)
# ==============================================================================
# Dependências do Composer
/vendor/

# Arquivos de ambiente e chaves específicas do Laravel
.env.backup
.env.testing
*.key

# Laravel Storage & Logs (Ignora o conteúdo, mas mantém a estrutura de pastas)
/storage/*.key
/storage/debugbar/
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/events/*
!/storage/framework/events/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore

# Caches do Laravel e Testes
bootstrap/cache/*
!bootstrap/cache/.gitignore
.phpunit.result.cache
.phpunit.cache
phpunit.xml

# Arquivos gerados pelo Vite/Mix no Laravel
/public/build
/public/hot
/public/storage

# Homestead e Valet
Homestead.json
Homestead.yaml
auth.json
.valet-cli.yml

# ==============================================================================
# 4. BANCO DE DADOS (Postgres / Docker)
# ==============================================================================
# Ignorar pastas de volume do Docker (se você rodar o Postgres via docker-compose)
/docker/postgres/data/
/pgdata/
/.docker-data/

# Dumps e backups de banco de dados
*.sql
*.dump
*.backup
*.sqlite
*.sqlite3
